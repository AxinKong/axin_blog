---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Subscribe from '../components/Subscribe.astro';
import PhaseTrack from '../components/PhaseTrack.astro';
import { url } from '../lib/url';

type Props = CollectionEntry<'work'>['data'];

const { title, subtitle, description, heroImage, role, team, timeline, stack, phase } =
	Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="cs-head">
					<p class="eyebrow">Case Study</p>
					<h1>{title}</h1>
					{subtitle && <p class="subtitle">{subtitle}</p>}
				</header>

				<PhaseTrack phase={phase} />

				<dl class="facts">
					<div>
						<dt>Role</dt>
						<dd>{role}</dd>
					</div>
					{
						team.length > 0 && (
							<div>
								<dt>Team</dt>
								<dd>{team.join(' · ')}</dd>
							</div>
						)
					}
					{
						timeline && (
							<div>
								<dt>Timeline</dt>
								<dd>{timeline}</dd>
							</div>
						)
					}
					{
						stack.length > 0 && (
							<div>
								<dt>Stack</dt>
								<dd>{stack.join(' · ')}</dd>
							</div>
						)
					}
				</dl>

				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}

				<div class="prose">
					<slot />
				</div>
			</article>

			<Subscribe />

			<nav class="back">
				<a href={url('/work')}>← All work</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.cs-head {
		padding-bottom: 1.2rem;
	}
	.eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.subtitle {
		margin: 0.4rem 0 0;
		font-size: 1.05rem;
		color: var(--text-muted);
		line-height: 1.6;
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1rem 1.5rem;
		margin: 0 0 2.5rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg-subtle);
	}
	.facts div {
		margin: 0;
	}
	.facts dt {
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.25rem;
	}
	.facts dd {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.hero {
		width: 100%;
		height: auto;
		margin-bottom: 2.5rem;
	}
	/* 案例研究里 h2 当作章节分隔，给一条线 */
	.prose :global(h2) {
		margin-top: 3rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--border);
	}
	.back {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
</style>
