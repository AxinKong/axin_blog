---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedWork } from '../../lib/work';
import { url } from '../../lib/url';

const items = await getPublishedWork();
const phaseLabel: Record<string, string> = {
	idea: 'Idea',
	poc: 'PoC',
	pilot: 'Pilot',
	production: 'In production',
	benefit: 'Benefit realization',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work · ${SITE_TITLE}`} description="Product case studies — from problem to delivery." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Work</h1>
			<p class="lede">
				Each case study documents one full loop: the problem I found, how I validated it,
				how I defined the product, how I worked with engineering, what users said,
				and what actually came out of it.
			</p>

			<ul class="work-list">
				{
					items.map((item) => (
						<li>
							<a href={url(`/work/${item.id}/`)}>
								<div class="row">
									<h2>{item.data.title}</h2>
									<span class="phase">{phaseLabel[item.data.phase]}</span>
								</div>
								{item.data.subtitle && <p class="sub">{item.data.subtitle}</p>}
								<p class="role">{item.data.role}</p>
							</a>
						</li>
					))
				}
			</ul>
			{items.length === 0 && <p class="empty">No public case studies yet.</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	.lede { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2.5rem; }
	.work-list { list-style: none; margin: 0; padding: 0; }
	.work-list li { margin: 0 0 1rem; }
	.work-list a {
		display: block;
		padding: 1.3rem 1.4rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		color: var(--text);
		transition: border-color 0.15s ease;
	}
	.work-list a:hover { text-decoration: none; border-color: var(--accent); }
	.row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
	.work-list h2 { margin: 0; font-size: 1.1rem; border: none; padding: 0; }
	.phase {
		flex-shrink: 0;
		font-size: 0.72rem;
		padding: 0.1em 0.55em;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
	}
	.sub { margin: 0.4rem 0 0; font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; }
	.role { margin: 0.6rem 0 0; font-size: 0.78rem; color: var(--text-muted); }
	.empty { color: var(--text-muted); }
</style>
