---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { TIP } from '../consts';

// 用 glob 而不是直接 import：图片没放进来时不会导致构建失败，只是不显示
const files = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/tip/*.{png,jpg,jpeg,webp}',
	{ eager: true },
);

const methods = TIP.methods.flatMap((m) => {
	const key = Object.keys(files).find((k) => k.endsWith(`/${m.file}`));
	return key ? [{ label: m.label, img: files[key].default }] : [];
});

const show = TIP.enabled && methods.length > 0;
---

{
	show && (
		<aside class="tip">
			<p class="tip-title">{TIP.title}</p>
			{TIP.note && <p class="tip-note">{TIP.note}</p>}
			<div class="codes">
				{methods.map((m) => (
					<figure>
						<Image src={m.img} alt={`${m.label}收款码`} width={280} densities={[1, 2]} />
						<figcaption>{m.label}</figcaption>
					</figure>
				))}
			</div>
		</aside>
	)
}

<style>
	.tip {
		margin-top: 3.5rem;
		padding: 1.8rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg-subtle);
		text-align: center;
	}
	.tip-title {
		margin: 0 0 0.4rem;
		font-weight: 700;
		font-size: 1.05rem;
	}
	.tip-note {
		margin: 0 auto 1.4rem;
		max-width: 34em;
		font-size: 0.88rem;
		line-height: 1.7;
		color: var(--text-muted);
	}
	.codes {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.8rem;
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		display: block;
		width: 140px;
		height: auto;
		border-radius: 8px;
		background: #fff;
		padding: 6px;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: 0.82rem;
		color: var(--text-muted);
	}
	@media (max-width: 480px) {
		.codes {
			gap: 1.2rem;
		}
		figure :global(img) {
			width: 120px;
		}
	}
</style>
