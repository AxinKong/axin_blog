---
// 技术链路：输入 → Skill → LLM → 草稿 → 校验 → 用户 → 反馈回流
const nodes = [
	{ x: 70, l1: 'Your record', l2: '+ JD' },
	{ x: 208, l1: 'Skill', l2: 'prompt + context' },
	{ x: 346, l1: 'LLM', l2: '' },
	{ x: 484, l1: 'Draft output', l2: 'structured' },
	{ x: 622, l1: 'Validation', l2: '', gate: true },
	{ x: 760, l1: 'User', l2: '' },
];
const W = 116, H = 44, Y = 56;
---

<figure class="diagram">
	<svg viewBox="0 0 840 280" role="img" aria-labelledby="pl-title pl-desc">
		<title id="pl-title">Technical pipeline with the validation gate</title>
		<desc id="pl-desc">
			Your record plus a job description feed a Skill, which prompts an LLM to produce a
			structured draft. A validation gate checks that the role is still open and that every
			claim traces back to your record before anything reaches you. Feedback from the user
			loops back into skill iteration.
		</desc>

		<defs>
			<marker id="ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M0,0 L8,4 L0,8 z" class="head" />
			</marker>
		</defs>

		{
			nodes.slice(0, -1).map((n, i) => (
				<line
					x1={n.x + W / 2}
					y1={Y + H / 2}
					x2={nodes[i + 1].x - W / 2 - 6}
					y2={Y + H / 2}
					class="flow"
					marker-end="url(#ar)"
				/>
			))
		}

		{
			nodes.map((n) => (
				<g>
					<rect
						x={n.x - W / 2}
						y={Y}
						width={W}
						height={H}
						rx="8"
						class:list={['box', { gate: n.gate }]}
					/>
					<text x={n.x} y={n.l2 ? Y + 20 : Y + 27} class:list={['lbl', { gatelbl: n.gate }]}>
						{n.l1}
					</text>
					{n.l2 && <text x={n.x} y={Y + 35} class="sub">{n.l2}</text>}
				</g>
			))
		}

		{/* 校验关口检查什么 */}
		<line x1="622" y1="100" x2="622" y2="128" class="tick" />
		<text x="622" y="148" class="check">Is the role still open?</text>
		<text x="622" y="166" class="checkref">H1 — against a live source</text>
		<text x="622" y="192" class="check">Does every claim trace to the record?</text>
		<text x="622" y="210" class="checkref">H2 — AI rewords, never originates</text>

		{/* 反馈回流 */}
		<path d="M760,100 L760,244 L208,244 L208,106" class="loop" marker-end="url(#ar)" />
		<text x="484" y="262" class="loopl">Feedback → skill iteration</text>
	</svg>
	<figcaption>
		Everything before the gate is generation. The gate is where this product actually differs —
		nothing reaches the user until the role is confirmed open and every claim is traced back to
		their own record.
	</figcaption>
</figure>

<style>
	.diagram { margin: 2rem 0; }
	svg { width: 100%; height: auto; overflow: visible; }
	.box {
		fill: var(--bg-subtle);
		stroke: var(--border);
		stroke-width: 1.5;
	}
	.box.gate {
		fill: var(--accent-soft);
		stroke: var(--accent);
		stroke-width: 2;
	}
	.lbl {
		fill: var(--text);
		font-size: 14px;
		font-weight: 700;
		text-anchor: middle;
	}
	.lbl.gatelbl { fill: var(--accent); }
	.sub {
		fill: var(--text-muted);
		font-size: 11px;
		text-anchor: middle;
	}
	.flow, .loop {
		stroke: var(--text-muted);
		fill: none;
		stroke-width: 1.5;
	}
	.loop { stroke-dasharray: 4 4; }
	.head { fill: var(--text-muted); }
	.tick {
		stroke: var(--accent);
		stroke-width: 1.5;
		stroke-dasharray: 3 3;
	}
	.check {
		fill: var(--text);
		font-size: 12px;
		font-weight: 600;
		text-anchor: middle;
	}
	.checkref, .loopl {
		fill: var(--text-muted);
		font-size: 11px;
		text-anchor: middle;
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.6;
		text-align: center;
	}
	@media (max-width: 600px) {
		.lbl { font-size: 17px; }
		.sub, .checkref, .loopl { font-size: 14px; }
		.check { font-size: 15px; }
	}
</style>
