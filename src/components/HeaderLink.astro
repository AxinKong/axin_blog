---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// 去掉 base 前缀和末尾斜杠后再比较，这样部署在子路径下高亮也正确
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const strip = (p: string) => (p.replace(BASE, '').replace(/\/+$/, '') || '/');

const current = strip(Astro.url.pathname);
const target = strip(String(href));
// 文章详情页 /blog/xxx 也要让「文章」高亮
const isActive = current === target || (target !== '/' && current.startsWith(`${target}/`));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	a {
		color: var(--text-muted);
	}
	a:hover,
	a.active {
		color: var(--text);
		text-decoration: none;
	}
	a.active {
		font-weight: 600;
	}
</style>
